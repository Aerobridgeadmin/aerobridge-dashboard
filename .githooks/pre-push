#!/bin/bash
# Pre-push hook: catch TypeScript errors before they hit Vercel
# Install: git config core.hooksPath .githooks

set -e

echo ""
echo "🔍 Running pre-push TypeScript check..."
echo ""

# Quick type-check on the main app (catches variable redeclarations, type errors, etc.)
cd "$(git rev-parse --show-toplevel)"

# Generate Prisma client if needed (type-check depends on it)
if [ ! -d "packages/database/generated" ]; then
  echo "  → Generating Prisma client..."
  pnpm --filter @repo/database build 2>/dev/null || true
fi

# Run TypeScript compiler in check mode (no output, just errors)
echo "  → Checking apps/app for type errors..."
npx tsc --noEmit --project apps/app/tsconfig.json 2>&1

if [ $? -eq 0 ]; then
  echo ""
  echo "✅ Type check passed — pushing to remote."
  echo ""
else
  echo ""
  echo "❌ Type errors found! Fix them before pushing."
  echo "   This prevents broken builds on Vercel."
  echo ""
  exit 1
fi
