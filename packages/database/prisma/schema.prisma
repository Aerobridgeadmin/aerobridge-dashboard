// ─────────────────────────────────────────────
// HRiq: Client Invoices
// Generated when timesheets are approved — charges the client org for contractor costs
// ─────────────────────────────────────────────

model ClientInvoice {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")

  invoiceNumber  String  @unique @map("invoice_number")
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  periodName     String?  @map("period_name")

  // Amounts
  subtotal     Decimal @map("subtotal") @db.Decimal(12, 2)       // sum of contractor costs
  rlFeeType    String? @map("rl_fee_type")                        // percentage | flat | per_contractor
  rlFeeAmount  Decimal? @map("rl_fee_amount") @db.Decimal(12, 2)  // fee config value
  rlFeeTotal   Decimal  @default(0) @map("rl_fee_total") @db.Decimal(12, 2) // calculated fee
  totalAmount  Decimal  @map("total_amount") @db.Decimal(12, 2)   // subtotal + fee
  currency     String   @default("USD")

  // Status: draft → sent → paid → void
  status String @default("draft")

  // Payment tracking
  paidAt          DateTime? @map("paid_at")
  paymentMethod   String?   @map("payment_method")
  paymentReference String?  @map("payment_reference")

  // Stripe
  stripeCheckoutSessionId String? @map("stripe_checkout_session_id")
  stripePaymentIntentId   String? @map("stripe_payment_intent_id")
  paymentLink             String? @map("payment_link")

  // QuickBooks sync
  qbInvoiceId  String?   @map("qb_invoice_id")
  qbSyncedAt   DateTime? @map("qb_synced_at")

  notes       String?
  invoiceUrl  String? @map("invoice_url")

  createdByUserId  String?  @map("created_by_user_id")
  createdByName    String?  @map("created_by_name")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItems    ClientInvoiceLineItem[]

  @@index([organizationId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([organizationId, status])
  @@index([qbInvoiceId])
  @@map("client_invoices")
}

model ClientInvoiceLineItem {
  id              String @id @default(cuid())
  clientInvoiceId String @map("client_invoice_id")
  employeeId      String @map("employee_id")

  description  String?
  hoursWorked  Decimal? @map("hours_worked") @db.Decimal(8, 2)
  hourlyRate   Decimal? @map("hourly_rate") @db.Decimal(8, 2)
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("USD")

  // PPP per-contractor payment tracking (direct charge on contractor's Express account)
  stripeCheckoutSessionId String?   @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?   @map("stripe_payment_intent_id")
  paymentLink             String?   @map("payment_link")
  paymentStatus           String    @default("pending") @map("payment_status")
  paidAt                  DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  clientInvoice ClientInvoice @relation(fields: [clientInvoiceId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([clientInvoiceId])
  @@index([employeeId])
  @@map("client_invoice_line_items")
}

// ─────────────────────────────────────────────
// HRiq: FCRA Background Check Compliance
// Tracks the full FCRA workflow for each candidate
// ─────────────────────────────────────────────

model BackgroundCheck {
  id         String  @id @default(cuid())
  employeeId String  @map("employee_id")

  // Status: pending_disclosure → disclosure_sent → authorized → check_ordered →
  //         check_complete → clear | pre_adverse_sent → adverse_sent | withdrawn
  status String @default("pending_disclosure")

  // CRA (Consumer Reporting Agency) info
  craName      String? @map("cra_name")       // e.g. "Checkr", "Sterling", "GoodHire"
  craOrderId   String? @map("cra_order_id")    // external reference
  craReportUrl String? @map("cra_report_url")  // link to full report

  // Disclosure & Authorization
  disclosureSentAt     DateTime? @map("disclosure_sent_at")
  disclosureSignedAt   DateTime? @map("disclosure_signed_at")
  disclosureDocumentId String?   @map("disclosure_document_id")  // link to stored PDF
  authorizationSignedAt DateTime? @map("authorization_signed_at")
  authorizationDocumentId String? @map("authorization_document_id")

  // Check results
  checkOrderedAt  DateTime? @map("check_ordered_at")
  checkCompletedAt DateTime? @map("check_completed_at")
  checkResult     String?   @map("check_result")  // clear | review | adverse
  checkSummary    String?   @map("check_summary")  // brief summary of findings

  // Pre-Adverse Action
  preAdverseNoticeSentAt DateTime? @map("pre_adverse_notice_sent_at")
  preAdverseReportSentAt DateTime? @map("pre_adverse_report_sent_at")
  preAdverseWaitUntil    DateTime? @map("pre_adverse_wait_until")  // typically 5 business days
  candidateDisputedAt    DateTime? @map("candidate_disputed_at")
  candidateDisputeNotes  String?   @map("candidate_dispute_notes")

  // Adverse Action
  adverseNoticeSentAt DateTime? @map("adverse_notice_sent_at")
  adverseReason       String?   @map("adverse_reason")

  // Final decision
  finalDecision   String?   @map("final_decision")  // proceed | reject | withdrawn
  decisionDate    DateTime? @map("decision_date")
  decisionByUserId String?  @map("decision_by_user_id")
  decisionByName  String?   @map("decision_by_name")
  decisionNotes   String?   @map("decision_notes")

  // Individualized assessment notes (required for ban-the-box / fair chance)
  assessmentNotes String? @map("assessment_notes")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  actions  FcraAction[]

  @@index([employeeId])
  @@index([status])
  @@map("background_checks")
}

model FcraAction {
  id               String @id @default(cuid())
  backgroundCheckId String @map("background_check_id")

  // Type: disclosure_sent | authorization_received | check_ordered | check_completed |
  //       pre_adverse_sent | dispute_received | adverse_sent | decision_made | note
  actionType  String  @map("action_type")
  description String?
  documentUrl String? @map("document_url")  // any attached document

  performedByUserId String? @map("performed_by_user_id")
  performedByName   String? @map("performed_by_name")

  createdAt DateTime @default(now()) @map("created_at")

  backgroundCheck BackgroundCheck @relation(fields: [backgroundCheckId], references: [id], onDelete: Cascade)

  @@index([backgroundCheckId])
  @@map("fcra_actions")
}

model CustomDropdownOption {
  id        String   @id @default(cuid())
  category  String
  value     String
  label     String
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  @@unique([category, value])
  @@index([category])
  @@map("custom_dropdown_options")
}

model QbToken {
  id                     String   @id
  companyId              String   @unique @map("company_id")
  accessToken            String   @map("access_token")
  refreshToken           String   @map("refresh_token")
  accessTokenExpiresAt   DateTime @map("access_token_expires_at")
  refreshTokenExpiresAt  DateTime @map("refresh_token_expires_at")
  connectedAt            DateTime @map("connected_at")
  updatedAt              DateTime @map("updated_at")

  @@map("hriq_qb_tokens")
}

model Contact {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName         String    @map("full_name")
  email            String?
  phone            String?
  jobTitle         String?   @map("job_title")
  role             String?   @default("primary")   // primary, billing, technical, other
  notes            String?
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdByUserId  String?   @map("created_by_user_id")
  createdByName    String?   @map("created_by_name")

  @@index([organizationId])
  @@index([email])
  @@map("hriq_contacts")
}

// Client-facing org onboarding — external multi-step wizard
model OrgOnboardingSession {
  id               String    @id @default(cuid())
  token            String    @unique @default(cuid())
  organizationId   String?   @map("organization_id")
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Status: draft, in_progress, completed, expired
  status           String    @default("draft")
  currentStep      Int       @default(1) @map("current_step")
  totalSteps       Int       @default(5) @map("total_steps")

  // Step 1: Company Info
  companyName      String?   @map("company_name")
  industry         String?
  companySize      String?   @map("company_size")
  website          String?
  country          String?
  address          String?

  // Step 2: Primary Contact
  contactName      String?   @map("contact_name")
  contactEmail     String?   @map("contact_email")
  contactPhone     String?   @map("contact_phone")
  contactTitle     String?   @map("contact_title")
  billingEmail     String?   @map("billing_email")

  // Step 3: Payment Method
  paymentMethod    String?   @map("payment_method")  // ppp, cor, both

  // Step 4: Documents / Preferences
  notes            String?
  preferences      Json?     @default("{}")

  // Metadata
  completedAt      DateTime? @map("completed_at")
  expiresAt        DateTime  @map("expires_at")
  createdByUserId  String?   @map("created_by_user_id")
  createdByName    String?   @map("created_by_name")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([token])
  @@index([organizationId])
  @@index([status])
  @@map("hriq_org_onboarding_sessions")
}

// ─── ACH Collection (COR clients) ───────────────────────────────────────────────

model AchCollection {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")

  // Period identifier: "A-2026-03" (6th–20th payout 30th) or "B-2026-03" (21st–5th payout 15th)
  payPeriod      String   @map("pay_period")

  // Amount to collect from client (String per platform pattern)
  amount         String

  scheduledDate  DateTime @map("scheduled_date")   // 3 business days before payoutDate
  payoutDate     DateTime @map("payout_date")       // 30th or 15th

  // SCHEDULED → PROCESSING → COLLECTED | FAILED → PERMANENTLY_FAILED
  status         String   @default("SCHEDULED")

  qbChargeId     String?  @map("qb_charge_id")      // returned by QB Payments API
  qbInvoiceId    String?  @map("qb_invoice_id")      // linked QB accounting invoice

  retryCount     Int      @default(0) @map("retry_count")
  failureReason  String?  @map("failure_reason")
  collectedAt    DateTime? @map("collected_at")      // webhook settlement timestamp
  idempotencyKey String   @default("") @map("idempotency_key")  // unique per charge attempt

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, payPeriod])
  @@index([status, scheduledDate])
  @@index([organizationId])
  @@map("hriq_ach_collections")
}

