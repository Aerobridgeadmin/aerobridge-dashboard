// ─────────────────────────────────────────────
// Timesheets: Submission & Approval (NEW)
// ─────────────────────────────────────────────

model TimesheetPeriod {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")

  name      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  status    String   @default("open")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions  TimesheetSubmission[]

  @@index([organizationId])
  @@index([startDate, endDate])
  @@index([organizationId, status])
  @@map("timesheet_periods")
}

model TimesheetSubmission {
  id         String @id @default(cuid())
  employeeId String @map("employee_id")
  periodId   String @map("period_id")

  mondayHours    Decimal @default(0) @db.Decimal(5, 2) @map("monday_hours")
  tuesdayHours   Decimal @default(0) @db.Decimal(5, 2) @map("tuesday_hours")
  wednesdayHours Decimal @default(0) @db.Decimal(5, 2) @map("wednesday_hours")
  thursdayHours  Decimal @default(0) @db.Decimal(5, 2) @map("thursday_hours")
  fridayHours    Decimal @default(0) @db.Decimal(5, 2) @map("friday_hours")
  saturdayHours  Decimal @default(0) @db.Decimal(5, 2) @map("saturday_hours")
  sundayHours    Decimal @default(0) @db.Decimal(5, 2) @map("sunday_hours")
  totalHours     Decimal @default(0) @db.Decimal(6, 2) @map("total_hours")

  // Start times per day (e.g. "09:00", "08:30")
  mondayStart    String? @map("monday_start")
  tuesdayStart   String? @map("tuesday_start")
  wednesdayStart String? @map("wednesday_start")
  thursdayStart  String? @map("thursday_start")
  fridayStart    String? @map("friday_start")
  saturdayStart  String? @map("saturday_start")
  sundayStart    String? @map("sunday_start")

  // Bonuses / commissions — JSON array of { description: string, amount: number }
  bonuses    Json?   @db.JsonB @map("bonuses")
  bonusTotal Decimal @default(0) @db.Decimal(10, 2) @map("bonus_total")

  // Per-date entries — JSON array of { date: string, timeIn?: string, timeOut?: string, hours: number }
  // Stores the full period's daily breakdown (replaces legacy Mon-Sun fields for new submissions)
  dailyEntries Json? @db.JsonB @map("daily_entries")

  notes String?

  status        String    @default("draft")
  submittedAt   DateTime? @map("submitted_at")
  approvedAt    DateTime? @map("approved_at")
  rejectedAt    DateTime? @map("rejected_at")
  autoApproveAt DateTime? @map("auto_approve_at")

  approvedByUserId String? @map("approved_by_user_id")
  approvedByName   String? @map("approved_by_name")
  rejectionReason  String? @map("rejection_reason")

  // Adjustment request flow: contractor requests edit → admin approves → contractor re-edits
  adjustmentStatus     String?   @map("adjustment_status")      // null | requested | approved | denied
  adjustmentNote       String?   @map("adjustment_note")        // contractor's reason for edit
  adjustmentApprovedAt DateTime? @map("adjustment_approved_at")
  adjustmentApprovedBy String?   @map("adjustment_approved_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period      TimesheetPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  payRunItems PayRunItem[]
  commissions Commission[]

  @@unique([employeeId, periodId])
  @@index([employeeId])
  @@index([periodId])
  @@index([status])
  @@index([status, employeeId])
  @@map("timesheet_submissions")
}

