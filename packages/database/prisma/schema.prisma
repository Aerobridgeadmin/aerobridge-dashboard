  organizationId String  @map("organization_id")

  name        String
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  // draft → pending_approval → approved → processing → completed → cancelled
  status String @default("draft")

  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  currency      String   @default("USD")
  rlFeeType     String?  @map("rl_fee_type")     // flat | percentage | per_contractor
  rlFeeAmount   Decimal? @map("rl_fee_amount") @db.Decimal(12, 2)
  rlFeeTotal    Decimal? @map("rl_fee_total") @db.Decimal(12, 2)
  grandTotal    Decimal  @default(0) @map("grand_total") @db.Decimal(12, 2)

  notes String?

  createdByUserId  String?   @map("created_by_user_id")
  createdByName    String?   @map("created_by_name")
  approvedByUserId String?   @map("approved_by_user_id")
  approvedByName   String?   @map("approved_by_name")
  approvedAt       DateTime? @map("approved_at")
  rejectedAt       DateTime? @map("rejected_at")
  rejectionReason  String?   @map("rejection_reason")
  paidAt           DateTime? @map("paid_at")

  stripePaymentIntentId String? @map("stripe_payment_intent_id")
  stripeInvoiceId       String? @map("stripe_invoice_id")
  paymentLink           String? @map("payment_link")

  summaryDocPath String? @map("summary_doc_path")  // Supabase storage path for auto-generated summary
  summaryDocUrl  String? @map("summary_doc_url")   // Signed URL (refreshed on access)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        PayRunItem[]

  @@index([organizationId])
  @@index([status])
