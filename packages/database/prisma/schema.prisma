// HRiq Platform — Prisma Schema
// Ported from Drizzle ORM with multi-tenancy via organizationId
// Existing tables use @map() to match snake_case column names in Supabase

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Multi-Tenancy: Organizations (NEW tables)
// ─────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl            String?  @map("logo_url")
  stripeCustomerId          String?  @map("stripe_customer_id")
  stripeConnectAccountId    String?  @map("stripe_connect_account_id")
  stripeConnectStatus       String?  @map("stripe_connect_status")
  qbCustomerId              String?  @map("qb_customer_id")
  // ACH collection (COR clients)
  qbBankAccountToken        String?  @map("qb_bank_account_token")
  qbBankAccountLast4        String?  @map("qb_bank_account_last4")
  achAuthorizedAt           DateTime? @map("ach_authorized_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  members           OrganizationMember[]
  invitations       OrganizationInvitation[]
  employees         Employee[]
  batchSessions     BatchSession[]
  auditLogs         AuditLog[]
  workflowTemplates WorkflowTemplate[]
  jotformTemplates  JotformTemplate[]
  approvedEmails    ApprovedEmail[]
  contractTemplates ContractTemplate[]
  timesheetPeriods  TimesheetPeriod[]
  timeOffPolicies   TimeOffPolicy[]
  expenseReports    ExpenseReport[]
  payRuns           PayRun[]
  serviceAgreements ServiceAgreement[]
  clientInvoices    ClientInvoice[]
  contacts          Contact[]
  orgOnboardingSessions OrgOnboardingSession[]
  achCollections        AchCollection[]

  profile OrganizationProfile?

  @@map("organizations")
}

model OrganizationProfile {
  id             String  @id @default(cuid())
  organizationId String  @unique @map("organization_id")
  industry       String?
  companySize    String? @map("company_size")
  website        String?
  country        String?
  address        String?
  adminName      String? @map("admin_name")
  adminEmail     String? @map("admin_email")
  adminPhone     String? @map("admin_phone")
  adminTitle     String? @map("admin_title")
  billingEmail   String? @map("billing_email")
  billingMethod  String? @default("ach") @map("billing_method")  // ach | credit_card | wire
  paymentTerms   String? @default("net_30") @map("payment_terms")
  docChecklist   Json?   @default("{}") @map("doc_checklist")

  // Payment method: ppp (client→contractor via Stripe Connect)
  //                 cor (client→RL via QuickBooks, RL→contractor via Wise)
  paymentMethod  String? @default("ppp") @map("payment_method")

  // Veriff KYC verification
  kycStatus          String?   @default("pending") @map("kyc_status")
  kycProvider        String?   @map("kyc_provider")
  veriffSessionId    String?   @map("veriff_session_id")
  veriffDecision     Json?     @map("veriff_decision")
  kycVerifiedAt      DateTime? @map("kyc_verified_at")
  kycVerifiedName    String?   @map("kyc_verified_name")
  kycDocumentType    String?   @map("kyc_document_type")
  kycDocumentCountry String?   @map("kyc_document_country")
  kycRejectionReason String?   @map("kyc_rejection_reason")
  kycSessionUrl      String?   @map("kyc_session_url")
  kycInitiatedAt     DateTime? @map("kyc_initiated_at")
  kycInitiatedBy     String?   @map("kyc_initiated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // Email suppression flags — set at org creation, respected throughout lifecycle
  suppressInviteEmail Boolean @default(false) @map("suppress_invite_email") // skip dashboard invite email on create
  suppressKycEmail    Boolean @default(false) @map("suppress_kyc_email")    // skip KYC verification email at first login

  // Seat / subscription info — set when org is created
  vaSeats   Int?    @map("va_seats")    // number of VA seats purchased
  planType  String? @map("plan_type")   // "ppp" | "cor" | "both"

  // PPP Invoice — QB invoice attached during org creation as proof of payment
  pppInvoice Json? @map("ppp_invoice")  // { id, docNumber, txnDate, totalAmount, customerName, status }

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([veriffSessionId])
  @@index([kycStatus])
  @@map("org_profiles")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String   @default("member")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  email          String
  role           String    @default("member")
  invitedBy      String    @map("invited_by")
  token          String    @unique @default(cuid())
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@map("organization_invitations")
}

// ─────────────────────────────────────────────
// Auth: Users & Access Control
// ─────────────────────────────────────────────

model AppUser {
  id             String    @id @default(cuid())
  supabaseUserId String    @unique @map("supabase_user_id")
  email          String    @unique
  displayName    String?   @map("display_name")
  profilePicture String?   @map("profile_picture")
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  loginCount     Int       @default(0)    @map("login_count")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("app_users")
}

model ApprovedEmail {
  id             String    @id @default(cuid())
  email          String
  role           String    @default("member")
  organizationId String?   @map("organization_id")
  addedByUserId  String?   @map("added_by_user_id")
  inviteSentAt   DateTime? @map("invite_sent_at")
  addedAt        DateTime  @default(now()) @map("added_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([email, organizationId])
  @@index([organizationId])
  @@map("approved_emails")
}

// ─────────────────────────────────────────────
// HRiq: Employees (EXISTING table — all fields @map)
// ─────────────────────────────────────────────

model Employee {
  id             String  @id @default(cuid())
  organizationId String? @map("organization_id")

  // Core Identity
  employeeNumber String  @unique @map("employee_number")
  legalFirstName String  @map("legal_first_name")
  secondName     String? @map("second_name")
  legalLastName  String  @map("legal_last_name")
  secondLastName String? @map("second_last_name")
  preferredName  String? @map("preferred_name")
  photoUrl       String? @map("photo_url")
  personalEmail  String? @map("personal_email")
  workEmail      String? @unique @map("work_email")
  username       String? @unique @map("username")
  phoneNumber    String? @map("phone_number")

  // Employment Details
  employmentType   String  @map("employment_type")
  department       String?
  jobTitle         String? @map("role")
  managerId        String? @map("manager_id")
  location         String?
  timezone         String?

  // Payment & Compensation
  paymentPlatform        String? @map("payment_platform")
  paymentAccountInfo     String? @map("payment_account_info")
  compensationType       String  @default("hourly") @map("compensation_type")     // hourly | monthly
  hourlyRate             Decimal? @map("hourly_rate") @db.Decimal(8, 2)
  monthlySalary          Decimal? @map("monthly_salary") @db.Decimal(10, 2)
  currency               String  @default("USD")
  preferredPaymentMethod String? @map("preferred_payment_method")                  // cadana | wise
  paymentMethodVerified  Boolean @default(false) @map("payment_method_verified")

  // Personal Info
  dateOfBirth      DateTime? @map("date_of_birth")
  streetAddress    String?   @map("street_address")
  city             String?
  stateProvince    String?   @map("state_province")
  postalCode       String?   @map("postal_code")
  country          String?
  mobileNumber     String?   @map("mobile_number")
  homePhone        String?   @map("home_phone")

  // Bank/Payment Details
  bankName          String? @map("bank_name")
  bankAccountNumber String? @map("bank_account_number")
  bankAccountName   String? @map("bank_account_name")
  bankSwiftCode     String? @map("bank_swift_code")
  bankRoutingNumber String? @map("bank_routing_number")
  debitCardNumber   String? @map("debit_card_number")
  bankAddress       String? @map("bank_address")
  bankExtraData     Json?   @map("bank_extra_data")

  // Emergency Contact
  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactPhone    String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")

  // Time Tracking
  // NOTE: String intentionally — Prisma Decimal breaks RSC serialization.
  dailyHoursTarget String  @default("7.25") @map("daily_hours_target")
  timeDoctorEmail  String? @map("time_doctor_email")

  // Slack
  slackInviteToken String? @map("slack_invite_token")
  googleSheetId    String? @map("google_sheet_id")

  // Stripe Connect (contractor payouts)
  stripeAccountId     String? @map("stripe_account_id")      // acct_xxx Connected Account ID
  stripeAccountStatus String? @map("stripe_account_status")  // pending | onboarding | verified | restricted | disabled

  // Wise (international contractor payouts)
  wiseRecipientId       Int?      @map("wise_recipient_id")
  wiseRecipientCurrency String?   @map("wise_recipient_currency")
  wiseRecipientType     String?   @map("wise_recipient_type")
  wiseRecipientSyncedAt DateTime? @map("wise_recipient_synced_at")
  wiseGateRequired      Boolean   @default(false) @map("wise_gate_required")
  wiseTag               String?   @map("wise_tag") // Wise username/email tag (e.g. @suhey or suhey@email.com) — can send money without full bank details

  // Cadana (global payroll — internal contractors)
  cadanaPersonId       String?   @map("cadana_person_id")
  cadanaPersonStatus   String?   @map("cadana_person_status")
  cadanaSyncedAt       DateTime? @map("cadana_synced_at")
  cadanaGateRequired   Boolean   @default(false) @map("cadana_gate_required")

  // QuickBooks
  qbVendorId String? @map("qb_vendor_id")

  // Dates
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  // Status Tracking
  employmentStatus  String @default("pre_hire")    @map("employment_status")
  onboardingStatus  String @default("not_started") @map("onboarding_status")
  offboardingStatus String @default("not_started") @map("offboarding_status")
  infoApprovalStatus String? @map("info_approval_status")  // null | pending_review | approved | rejected

  // HRIQ Role
  hriqRole String @default("employee") @map("hriq_role")

  // Relations to users / external systems
  linkedUserId       String?   @map("linked_user_id")
  recruitCrmId       String?   @map("recruit_crm_id")
  recruitCrmSlug     String?   @map("recruit_crm_slug")
  recruitCrmSyncedAt DateTime? @map("recruit_crm_synced_at")

  // Veriff KYC (contractor identity verification)
  veriffSessionId      String?   @map("veriff_session_id")
  veriffStatus         String?   @map("veriff_status")          // created | started | submitted | approved | declined | resubmission_requested
  veriffDecision       Json?     @map("veriff_decision")
  veriffVerifiedAt     DateTime? @map("veriff_verified_at")
  veriffVerifiedName   String?   @map("veriff_verified_name")
  veriffDocumentType   String?   @map("veriff_document_type")
  veriffDocumentCountry String?  @map("veriff_document_country")
  veriffRejectionReason String?  @map("veriff_rejection_reason")

  // Metadata
  isLocked        Boolean  @default(false)  @map("is_locked")
  selfServiceToken String? @unique @map("self_service_token")

  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now())  @map("created_at")
  updatedAt       DateTime @updatedAt       @map("updated_at")

  // Self-reference
  manager  Employee?  @relation("EmployeeManager", fields: [managerId], references: [id])
  reports  Employee[] @relation("EmployeeManager")

  // Org relation (nullable for existing rows without org)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Child records
  tasks                   Task[]
  documents               Document[]
  payments                Payment[]
  accessProvisioning      AccessProvisioning[]
  managerNotes            ManagerNote[]
  onboardingSessions      OnboardingSession[]
  contractSigningRequests ContractSigningRequest[]
  timesheetSubmissions    TimesheetSubmission[]
  timeOffRequests         TimeOffRequest[]
  timeOffBalances         TimeOffBalance[]
  expenseReports          ExpenseReport[]
  payRunItems             PayRunItem[]
  clientInvoiceLineItems  ClientInvoiceLineItem[]
  backgroundChecks        BackgroundCheck[]
  commissions             Commission[]

  @@index([organizationId])
  @@index([employmentStatus])
  @@index([onboardingStatus])
  @@index([managerId])
  @@index([linkedUserId])
  @@index([personalEmail])
  @@index([workEmail])
  @@index([organizationId, employmentStatus])
  @@index([organizationId, infoApprovalStatus])
  // NOTE: idx_employees_email_org unique index pending — resolve v.mariajose.r@gmail.com dupe in org_rl_001 first
  // @@unique([personalEmail, organizationId]) — target constraint
  @@map("hriq_employees")
}

// ─────────────────────────────────────────────
// HRiq: Tasks (EXISTING)
// ─────────────────────────────────────────────

model Task {
  id         String @id @default(cuid())
  employeeId String @map("employee_id")

  taskType    String  @map("task_type")
  title       String
  description String?

  ownerRole        String? @map("owner_role")
  assignedToUserId String? @map("assigned_to_user_id")

  dueDate DateTime? @map("due_date")

  status     String  @default("pending") @map("status")
  isBlocking Boolean @default(false)     @map("is_blocking")

  completedAt       DateTime? @map("completed_at")
  completedByUserId String?   @map("completed_by_user_id")

  phase String?

  notes    String?
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([assignedToUserId])
  @@index([employeeId, status])
  @@map("hriq_tasks")
}

// ─────────────────────────────────────────────
// HRiq: Documents (EXISTING)
// ─────────────────────────────────────────────

model Document {
  id         String @id @default(cuid())
  employeeId String @map("employee_id")

  documentType String @map("document_type")
  documentName String @map("document_name")
  description  String?

  fileUrl  String? @map("file_url")
  filePath String? @map("file_path")   // Supabase storage path for regenerating signed URLs
  fileName String? @map("file_name")
  fileSize Int?    @map("file_size")
  mimeType String? @map("mime_type")

  issuedDate DateTime? @map("issued_date")
  expiryDate DateTime? @map("expiry_date")
  isExpired  Boolean   @default(false) @map("is_expired")

  status           String    @default("pending")
  rejectionReason  String?   @map("rejection_reason")
  verifiedByUserId String?   @map("verified_by_user_id")
  verifiedAt       DateTime? @map("verified_at")

  isConfidential Boolean @default(false) @map("is_confidential")

  folder String @default("other") @map("folder") // contracts, pay, identity, tax, banking, other

  uploadedByUserId String?  @map("uploaded_by_user_id")
  uploadedByName   String?  @map("uploaded_by_name")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([documentType])
  @@index([status])
  @@index([employeeId, status])
  @@index([employeeId, documentType])
  @@index([employeeId, folder])
  @@map("hriq_documents")
}

// ─────────────────────────────────────────────
// HRiq: Payments (EXISTING)
// ─────────────────────────────────────────────

model Payment {
  id         String @id @default(cuid())
  employeeId String @map("employee_id")

  paymentType String @default("salary") @map("payment_type")
  // NOTE: amount/hoursWorked/hourlyRate are String intentionally — Prisma Decimal
  // breaks RSC serialization across server/client boundary (hydration mismatch #418).
  amount      String
  currency    String @default("USD")

  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")

  paymentDate   DateTime? @map("payment_date")
  paymentMethod String?   @map("payment_method")
  transactionId String?   @map("transaction_id")

  status String @default("pending")

  // Payout tracking (Wise, bank transfer, PayPal, etc.)
  payoutProvider    String?   @map("payout_provider")      // wise | bank_transfer | paypal | crypto | other
  payoutReference   String?   @map("payout_reference")     // external transaction ID
  payoutReceiptUrl  String?   @map("payout_receipt_url")   // screenshot or receipt link
  payoutConfirmedAt DateTime? @map("payout_confirmed_at")
  payoutConfirmedBy String?   @map("payout_confirmed_by")  // userId who confirmed

  // Wise API transfer tracking
  wiseTransferId        Int?      @map("wise_transfer_id")
  wiseQuoteId           String?   @map("wise_quote_id")
  wiseTransferStatus    String?   @map("wise_transfer_status")
  wiseSourceAmount      Decimal?  @map("wise_source_amount") @db.Decimal(12, 2)
  wiseTargetAmount      Decimal?  @map("wise_target_amount") @db.Decimal(12, 2)
  wiseTargetCurrency    String?   @map("wise_target_currency")
  wiseExchangeRate      Decimal?  @map("wise_exchange_rate") @db.Decimal(16, 6)
  wiseFee               Decimal?  @map("wise_fee") @db.Decimal(12, 2)
  wiseEstimatedDelivery DateTime? @map("wise_estimated_delivery")
  wiseFundedAt          DateTime? @map("wise_funded_at")

  // QuickBooks sync
  qbBillId        String?   @map("qb_bill_id")
  qbBillPaymentId String?   @map("qb_bill_payment_id")
  qbVendorId      String?   @map("qb_vendor_id")
  qbSyncedAt      DateTime? @map("qb_synced_at")

  // Invoice
  invoiceUrl    String? @map("invoice_url")
  invoiceNumber String? @map("invoice_number")

  hoursWorked String? @map("hours_worked")
  hourlyRate  String? @map("hourly_rate")

  description String?
  notes       String?

  processedByUserId String?  @map("processed_by_user_id")
  processedByName   String?  @map("processed_by_name")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payRunItems PayRunItem[]

  @@index([employeeId])
  @@index([status])
  @@index([status, employeeId])
  @@index([employeeId, periodStart, periodEnd])
  @@index([createdAt])
  @@map("hriq_payments")
}

// ─────────────────────────────────────────────
// HRiq: Commissions (Hiring Manager commissions from QB payments)
// ─────────────────────────────────────────────

model Commission {
  id             String @id @default(cuid())
  commissionType String @default("hiring_manager") @map("commission_type")
  employeeId     String @map("employee_id")

  // Commission tier: standard(0.6%) | bundle(1%) | ae(1.2%) | bundle_ae(2%) | ppp(2%) | bundle_fill($20 flat)
  commissionTier String @default("standard") @map("commission_tier")

  // Client + revenue reference
  clientName    String?  @map("client_name")
  revenueAmount Decimal? @db.Decimal(12, 2) @map("revenue_amount")

  // QuickBooks payment reference
  qbPaymentRef         String?   @map("qb_payment_ref")
  qbVendorName         String?   @map("qb_vendor_name")
  qbPaymentAmount      Decimal?  @db.Decimal(12, 2) @map("qb_payment_amount")
  qbPaymentDate        DateTime? @map("qb_payment_date")
  qbInvoiceNumber      String?   @map("qb_invoice_number")

  // Commission calculation
  commissionRate   Decimal @default(0.006) @db.Decimal(5, 4) @map("commission_rate")
  commissionAmount Decimal @db.Decimal(12, 2) @map("commission_amount")
  currency         String  @default("USD")

  // Workflow
  status String @default("pending") // pending | approved | rejected | paid

  assignedByUserId String? @map("assigned_by_user_id")
  assignedByName   String? @map("assigned_by_name")

  approvedByUserId String?   @map("approved_by_user_id")
  approvedByName   String?   @map("approved_by_name")
  approvedAt       DateTime? @map("approved_at")

  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason")

  timesheetSubmissionId String? @map("timesheet_submission_id")

  description String?
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timesheetSubmission TimesheetSubmission? @relation(fields: [timesheetSubmissionId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([commissionType])
  @@index([createdAt])
  @@map("hriq_commissions")
}

// ─────────────────────────────────────────────
// HRiq: Access Provisioning (EXISTING)
// ─────────────────────────────────────────────

model AccessProvisioning {
  id         String @id @default(cuid())
  employeeId String @map("employee_id")

  systemName     String  @map("system_name")
  systemCategory String? @map("system_category")
  accessLevel    String? @map("access_level")

  status                String    @default("pending")
  provisionedAt         DateTime? @map("provisioned_at")
  provisionedByUserId   String?   @map("provisioned_by_user_id")
  deprovisionedAt       DateTime? @map("deprovisioned_at")
  deprovisionedByUserId String?   @map("deprovisioned_by_user_id")

  revocationPriority Int @default(100) @map("revocation_priority")

  notes    String?
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("hriq_access_provisioning")
}

// ─────────────────────────────────────────────
// HRiq: Manager Notes (EXISTING)
// ─────────────────────────────────────────────

model ManagerNote {
  id         String @id @default(cuid())
  employeeId String @map("employee_id")

  authorUserId String? @map("author_user_id")
  authorName   String? @map("author_name")

  noteType  String  @default("general") @map("note_type")
  content   String
  isPrivate Boolean @default(false) @map("is_private")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("hriq_manager_notes")
}

// ─────────────────────────────────────────────
// HRiq: Audit Log (EXISTING)
// ─────────────────────────────────────────────

model AuditLog {
  id             String  @id @default(cuid())
  organizationId String? @map("organization_id")

  timestamp DateTime @default(now())

  actorType        String  @map("actor_type")
  actorUserId      String? @map("actor_user_id")
  actorDescription String? @map("actor_description")

  action String

  objectType String @map("object_type")
  objectId   String @map("object_id")

  oldValue Json? @map("old_value")
  newValue Json? @map("new_value")

  reason    String?
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([objectType, objectId])
  @@index([actorUserId])
  @@index([timestamp])
  @@index([organizationId, timestamp])
  @@index([organizationId, action])
  @@map("hriq_audit_log")
}

// ─────────────────────────────────────────────
// HRiq: Batch Onboarding Sessions (EXISTING)
// ─────────────────────────────────────────────

model BatchSession {
  id             String  @id @default(cuid())
  organizationId String? @map("organization_id")

  title       String
  description String?

  zoomMeetingId       String?   @map("zoom_meeting_id")
  zoomMeetingLink     String?   @map("zoom_meeting_link")
